{
  "name": "fmworks-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "build": "tsx scripts/generate-sitemap.ts && vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && oxlint -D react-hooks/rules-of-hooks -D typescript/no-explicit-any -D eslint/eqeqeq -D eslint/no-self-compare -D eslint/no-constant-binary-expression -D eslint/no-template-curly-in-string -A eslint/no-control-regex src server.ts scripts vite.config.ts && eslint scripts/*.mjs eslint.config.mjs",
    "test": "tsx --test src/**/*.test.ts",
    "audit:quality": "npm run lint && npm test && npm run build && tsx scripts/quality-audit.ts"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@google/genai": "^3.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0"
  }
}
