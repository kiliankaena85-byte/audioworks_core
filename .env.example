# ALLOW_FOREIGN_GEMINI_API: Under 152-FZ (RF), outbound calls to foreign Google Gemini API are disabled by default (set "true" only for non-PDN internal tools with explicit consent).
ALLOW_FOREIGN_GEMINI_API="false"

# GEMINI_API_KEY: Optional API key when ALLOW_FOREIGN_GEMINI_API="true" and AIRTIME_SALES_ENABLED=true (never send client PDN).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STUDIO_ADMIN_PASSWORD: Password required to sign in to the /admin Studio CMS cabinet.
STUDIO_ADMIN_PASSWORD="CHANGE_ME_STUDIO_PASSWORD"

# CMS_SESSION_SECRET: HMAC signing secret for /admin Studio CMS session tokens.
CMS_SESSION_SECRET="CHANGE_ME_RANDOM_SESSION_SECRET"

# TELEGRAM_ORDERS_BOT_TOKEN & TELEGRAM_ORDERS_CHAT_ID: Optional Telegram Bot credentials for instant producer order alerts.
TELEGRAM_ORDERS_BOT_TOKEN=""
TELEGRAM_ORDERS_CHAT_ID=""

# ORDERS_WEBHOOK_URL & ORDERS_WEBHOOK_SECRET: Optional external CRM webhook endpoint (amoCRM / Bitrix24 / Make) and HMAC signing secret.
ORDERS_WEBHOOK_URL=""
ORDERS_WEBHOOK_SECRET=""

# DADATA_API_KEY: Optional DaData Party API token for live EGRUL/EGRIP auto-requisites lookup by INN (server-side only).
DADATA_API_KEY=""

# KONTUR_FOCUS_API_KEY: Optional Kontur.Focus API key for EGRUL/EGRIP counterparty verification by INN (server-side only).
KONTUR_FOCUS_API_KEY=""

# DIADOC_API_KEY, DIADOC_AUTH_TOKEN, DIADOC_LOGIN, DIADOC_PASSWORD, DIADOC_BOX_ID:
# Optional Kontur.Diadoc REST API (https://diadoc-api.kontur.ru) credentials for counterparty EDO Box lookup
# and safe server-side invoice draft creation (POST /V3/PostMessage with IsDraft=true, no KEP private key on server).
DIADOC_API_KEY=""
DIADOC_AUTH_TOKEN=""
DIADOC_LOGIN=""
DIADOC_PASSWORD=""
DIADOC_BOX_ID=""

# MAGIC_LINK_WEBHOOK_URL: Optional HTTPS transactional mail gateway webhook (Unisender Go / RuPost / Postbox) for sending passwordless magic-link emails.
MAGIC_LINK_WEBHOOK_URL=""

